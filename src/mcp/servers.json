{
  "mcpServers": {
    "context7": {
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "${CONTEXT7_API_KEY}"
      ],
      "command": "npx",
      "type": "stdio"
    },
    "keenable": {
      "type": "http",
      "url": "https://api.keenable.ai/mcp",
      "headers": {
        "X-API-Key": "${KEENABLE_API_KEY}"
      }
    },
    "verify": {
      "args": [
        "-y",
        "verify-mcp@latest"
      ],
      "command": "npx",
      "type": "stdio"
    }
  }
}
