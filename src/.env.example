# Copy to ~/.claude/.env, fill in the real values, then `chmod 600 ~/.claude/.env`.
# Sourced by the `claude` shell wrapper (see README) and by ./setup.sh.
# Names only here — never commit values.

# Proxy. Leave empty when not behind one.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# GitLab — review-task-fetch hook only; `glab` authenticates itself via `glab auth login`.
# GITLAB_HOST is a bare host, no scheme.
GITLAB_HOST=
GITLAB_PAT=

# Grafana — the grafana skill. The instance is reached through a port-forward to its pod.
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_K8S_NAMESPACE=
GRAFANA_K8S_SERVICE=

# Docs and web search MCP.
CONTEXT7_API_KEY=
KEENABLE_API_KEY=

# Kubernetes — the k8s skill. Paths to kubeconfig files and the namespace per environment.
KUBECONFIG_DEV=
KUBECONFIG_STAGE=
K8S_NAMESPACE_DEV=
K8S_NAMESPACE_STAGE=

# Jira — review-task-fetch hook. JIRA_URL is a bare host, no scheme.
JIRA_URL=
JIRA_PAT=

# Postgres — infra-mcp-postgres plugin.
PGPASSWORD_DEV=
PGPASSWORD_STAGE=
